+static int os08a20_get_format_code(struct os08a20 *sensor, u32 *code)
+{
+	return os08a20_get_mode_format_code(&sensor->cur_mode, code);
+}
+
+/*
+ * Find a sensor mode matching the requested pad format.
+ *
+ * Prefer the current mode when it already matches. This is important for HDR:
+ * 1920x1080 RAW10 exists as both linear and HDR, and pad format alone cannot
+ * distinguish those modes. VVSENSORIOC_S_SENSOR_MODE remains authoritative
+ * for explicitly selecting HDR/linear mode.
+ */
+static const struct vvcam_mode_info_s *
+os08a20_find_mode(struct os08a20 *sensor,
+		  const struct v4l2_mbus_framefmt *format)
+{
+	const struct vvcam_mode_info_s *mode;
+	u32 code;
+	int i;
+
+	/*
+	 * VVCAM/isp_media_server may call S_FMT with code == 0 after first
+	 * selecting the sensor mode through VVSENSORIOC_S_SENSOR_MODE.
+	 * Treat code == 0 as "unspecified" and preserve cur_mode when the
+	 * requested dimensions match it. set_fmt() will fill in the actual
+	 * media-bus code from cur_mode.
+	 */
+	if (sensor->cur_mode.size.bounds_width == format->width &&
+	    sensor->cur_mode.size.bounds_height == format->height &&
+	    !os08a20_get_mode_format_code(&sensor->cur_mode, &code) &&
+	    (format->code == 0 || code == format->code))
+		return &sensor->cur_mode;
+
+	/*
+	 * For normal V4L2 callers with an explicit media-bus code, find the
+	 * matching mode by width/height/code. Do not guess another mode for
+	 * code == 0: VVCAM already selected the authoritative cur_mode above.
+	 */
+	if (format->code == 0)
+		return NULL;
+
+	for (i = 0; i < ARRAY_SIZE(pos08a20_mode_info); i++) {
+		mode = &pos08a20_mode_info[i];
+
+		if (mode->size.bounds_width != format->width ||
+		    mode->size.bounds_height != format->height)
+			continue;
+
+		if (os08a20_get_mode_format_code(mode, &code))
+			continue;
+
+		if (code == format->code)
+			return mode;
+	}
+
+	return NULL;
+}

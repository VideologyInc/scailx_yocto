 #if LINUX_VERSION_CODE > KERNEL_VERSION(5, 12, 0)
 static int os08a20_enum_mbus_code(struct v4l2_subdev *sd,
-				struct v4l2_subdev_state *state,
-				struct v4l2_subdev_mbus_code_enum *code)
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
 #else
 static int os08a20_enum_mbus_code(struct v4l2_subdev *sd,
-			         struct v4l2_subdev_pad_config *cfg,
-			         struct v4l2_subdev_mbus_code_enum *code)
+				  struct v4l2_subdev_pad_config *cfg,
+				  struct v4l2_subdev_mbus_code_enum *code)
 #endif
 {
-	struct i2c_client *client = v4l2_get_subdevdata(sd);
-	struct os08a20 *sensor = client_to_os08a20(client);
+	/*
+	 * All current OS08A20 modes are BGGR and use either RAW10 or RAW12.
+	 * Expose both codes instead of only the code of cur_mode.
+	 */
+	switch (code->index) {
+	case 0:
+		code->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+		break;
+	case 1:
+		code->code = MEDIA_BUS_FMT_SBGGR12_1X12;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
 
-	u32 cur_code = MEDIA_BUS_FMT_SBGGR12_1X12;
+#if LINUX_VERSION_CODE > KERNEL_VERSION(5, 12, 0)
+static int os08a20_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+#else
+static int os08a20_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_pad_config *cfg,
+				   struct v4l2_subdev_frame_size_enum *fse)
+#endif
+{
+	u32 code;
+	unsigned int match = 0;
+	int i;
 
-	if (code->index > 0)
+	if (fse->pad != OS08A20_SENS_PAD_SOURCE)
 		return -EINVAL;
-	os08a20_get_format_code(sensor,&cur_code);
-	code->code = cur_code;
 
-	return 0;
+	/*
+	 * Enumerate unique width/height combinations for the requested code.
+	 * Duplicate linear/HDR modes with identical pad format are returned once.
+	 */
+	for (i = 0; i < ARRAY_SIZE(pos08a20_mode_info); i++) {
+		const struct vvcam_mode_info_s *mode = &pos08a20_mode_info[i];
+		int j;
+		bool duplicate = false;
+
+		if (os08a20_get_mode_format_code(mode, &code) || code != fse->code)
+			continue;
+
+		for (j = 0; j < i; j++) {
+			const struct vvcam_mode_info_s *prev = &pos08a20_mode_info[j];
+			u32 prev_code;
+
+			if (os08a20_get_mode_format_code(prev, &prev_code) ||
+			    prev_code != fse->code)
+				continue;
+
+			if (prev->size.bounds_width == mode->size.bounds_width &&
+			    prev->size.bounds_height == mode->size.bounds_height) {
+				duplicate = true;
+				break;
+			}
+		}
+
+		if (duplicate)
+			continue;
+
+		if (match++ != fse->index)
+			continue;
+
+		fse->min_width = mode->size.bounds_width;
+		fse->max_width = mode->size.bounds_width;
+		fse->min_height = mode->size.bounds_height;
+		fse->max_height = mode->size.bounds_height;
+		return 0;
+	}
+
+	return -EINVAL;
 }

 #if LINUX_VERSION_CODE > KERNEL_VERSION(5, 12, 0)
 static int os08a20_set_fmt(struct v4l2_subdev *sd,
 			   struct v4l2_subdev_state *state,
@@ -826,38 +968,85 @@ static int os08a20_set_fmt(struct v4l2_subdev *sd,
 			   struct v4l2_subdev_format *fmt)
 #endif
 {
-	int ret = 0;
 	struct i2c_client *client = v4l2_get_subdevdata(sd);
 	struct os08a20 *sensor = client_to_os08a20(client);
-	mutex_lock(&sensor->lock);
+	const struct vvcam_mode_info_s *mode;
+	u32 code;
+	int ret = 0;
 
-	if ((fmt->format.width != sensor->cur_mode.size.bounds_width) ||
-	    (fmt->format.height != sensor->cur_mode.size.bounds_height)) {
-		pr_err("%s:set sensor format %dx%d error\n",
-			__func__,fmt->format.width,fmt->format.height);
-		mutex_unlock(&sensor->lock);
+	if (fmt->pad != OS08A20_SENS_PAD_SOURCE)
 		return -EINVAL;
+
+	mutex_lock(&sensor->lock);
+
+	mode = os08a20_find_mode(sensor, &fmt->format);
+	if (!mode) {
+		dev_err(&client->dev,
+			"unsupported sensor format %ux%u code=0x%08x (current mode=%u %ux%u)\n",
+			fmt->format.width, fmt->format.height, fmt->format.code,
+			sensor->cur_mode.index,
+			sensor->cur_mode.size.bounds_width,
+			sensor->cur_mode.size.bounds_height);
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+
+	/*
+	 * A TRY format must not change sensor state or touch hardware.
+	 * Return the exact format represented by the matched mode.
+	 */
+	if (os08a20_get_mode_format_code(mode, &code)) {
+		ret = -EINVAL;
+		goto out_unlock;
 	}
 
-	os08a20_write_reg(sensor, 0x100, 0x00);
-	os08a20_write_reg(sensor, 0x103, 0x01);
+	fmt->format.width = mode->size.bounds_width;
+	fmt->format.height = mode->size.bounds_height;
+	fmt->format.code = code;
+	fmt->format.field = V4L2_FIELD_NONE;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		goto out_unlock;
+
+	/*
+	 * Keep VVSENSORIOC_S_SENSOR_MODE authoritative when the current mode
+	 * already has the same pad format (for example 1080p RAW10 linear/HDR).
+	 * Otherwise select the unique mode identified by width/height/code.
+	 */
+	if (mode != &sensor->cur_mode)
+		memcpy(&sensor->cur_mode, mode, sizeof(sensor->cur_mode));
+
+	ret = os08a20_write_reg(sensor, 0x0100, 0x00);
+	if (ret < 0)
+		goto out_unlock;
+
+	ret = os08a20_write_reg(sensor, 0x0103, 0x01);
+	if (ret < 0)
+		goto out_unlock;
+
 	msleep(20);
 
 	ret = os08a20_write_reg_arry(sensor,
 		(struct vvcam_sccb_data_s *)sensor->cur_mode.preg_data,
 		sensor->cur_mode.reg_data_count);
 	if (ret < 0) {
-		pr_err("%s:os08a20_write_reg_arry error\n",__func__);
-		mutex_unlock(&sensor->lock);
-		return -EINVAL;
+		dev_err(&client->dev, "failed to program sensor mode %u\n",
+			sensor->cur_mode.index);
+		goto out_unlock;
 	}
 
-	os08a20_get_format_code(sensor, &fmt->format.code);
-	fmt->format.field = V4L2_FIELD_NONE;
 	sensor->format = fmt->format;
+
+	dev_dbg(&client->dev,
+		"set format %ux%u code=0x%08x mode=%u hdr=%u\n",
+		fmt->format.width, fmt->format.height, fmt->format.code,
+		sensor->cur_mode.index, sensor->cur_mode.hdr_mode);
+
+out_unlock:
 	mutex_unlock(&sensor->lock);
-	return 0;
+	return ret;
 }
